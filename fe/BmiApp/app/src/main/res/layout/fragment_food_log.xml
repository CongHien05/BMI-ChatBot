<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_subtle"
    android:fillViewport="true"
    tools:context=".ui.main.log.FoodLogFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🍽️ Ghi lại bữa ăn"
                        android:textAppearance="@style/TextAppearance.Material3.HeadlineMedium"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:letterSpacing="0.02" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Theo dõi dinh dưỡng hàng ngày của bạn"
                        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                        android:textColor="@color/text_secondary"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <!-- Action buttons - Modern Icon Button Group -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#E0E0E0"
                    app:cardBackgroundColor="@color/white">
                    
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="4dp"
                        android:gravity="center_vertical">
                        
                        <!-- History button - Icon only -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/buttonHistory"
                            style="@style/Widget.Material3.Button.IconButton"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:contentDescription="Xem lịch sử"
                            app:icon="@android:drawable/ic_menu_recent_history"
                            app:iconTint="@color/gradient_start_food"
                            app:iconSize="20dp"
                            app:iconPadding="0dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:insetLeft="0dp"
                            android:insetRight="0dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
            
            <!-- Filter Chips Row -->
            <com.google.android.material.chip.ChipGroup
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:singleSelection="false"
                app:chipSpacing="8dp">
                
                <!-- Toggle Favorites Button -->
                <com.google.android.material.chip.Chip
                    android:id="@+id/buttonToggleFavorites"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Yêu thích"
                    android:textSize="12sp"
                    style="@style/Widget.Material3.Chip.Filter"
                    app:chipBackgroundColor="@color/chip_background_food"
                    app:chipStrokeColor="@color/gradient_start_food"
                    app:chipStrokeWidth="1.5dp"
                    android:textColor="@color/gradient_start_food"
                    app:chipIcon="@android:drawable/btn_star_big_off"
                    app:chipIconTint="@color/gradient_start_food"
                    app:chipIconSize="16dp"
                    android:checkable="false"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:minHeight="36dp" />
                
                <!-- Toggle My Foods Button -->
                <com.google.android.material.chip.Chip
                    android:id="@+id/buttonToggleMyFoods"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Món của tôi"
                    android:textSize="12sp"
                    style="@style/Widget.Material3.Chip.Filter"
                    app:chipBackgroundColor="@color/chip_background_food"
                    app:chipStrokeColor="@color/gradient_start_food"
                    app:chipStrokeWidth="1.5dp"
                    android:textColor="@color/gradient_start_food"
                    app:chipIcon="@android:drawable/ic_menu_edit"
                    app:chipIconTint="@color/gradient_start_food"
                    app:chipIconSize="16dp"
                    android:checkable="false"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:minHeight="36dp" />
            </com.google.android.material.chip.ChipGroup>
        </LinearLayout>

        <!-- Favorites RecyclerView (hidden by default) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardFavorites"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/white"
            android:visibility="gone">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerFavorites"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:nestedScrollingEnabled="false" />
        </com.google.android.material.card.MaterialCardView>

        <!-- My Custom Foods RecyclerView (hidden by default) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardMyFoods"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/white"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="📝 Món của tôi"
                        android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonCreateCustomFood"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tạo mới"
                        android:textSize="12sp"
                        app:icon="@android:drawable/ic_input_add"
                        app:iconTint="@color/gradient_start_food" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerMyFoods"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Recently Used Section -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardRecent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/white"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🕐 Gần đây"
                    android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="12dp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerRecent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- AI Recommendations Section - Moved to TOP -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardRecommendations"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="?attr/colorSurfaceVariant"
            app:strokeWidth="0dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_sparkle_24"
                        android:layout_marginEnd="8dp"
                        android:contentDescription="Sparkle icon" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Gợi ý món ăn cho bạn"
                        android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/textRecommendationExplanation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Đang tải gợi ý..."
                    android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                    android:textColor="@color/text_secondary"
                    android:layout_marginBottom="12dp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerRecommendations"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonShowMoreRecommendations"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Xem thêm"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:textColor="?attr/colorPrimary"
                    android:visibility="gone" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Form Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardForm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/white"
            app:strokeWidth="0dp"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Label for Food search -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tìm kiếm món ăn"
                    android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                    android:textColor="@color/text_secondary"
                    android:layout_marginBottom="8dp" />

                <!-- Food selection with search - Filled style -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:startIconDrawable="@drawable/ic_search_24"
                    app:startIconTint="@color/gradient_start_food"
                    app:endIconMode="clear_text"
                    app:helperText="Gõ tên món ăn để tìm kiếm nhanh"
                    app:helperTextEnabled="true"
                    app:boxBackgroundMode="filled"
                    app:boxBackgroundColor="#FAFAFA"
                    app:boxCornerRadiusTopStart="16dp"
                    app:boxCornerRadiusTopEnd="16dp"
                    app:boxCornerRadiusBottomStart="16dp"
                    app:boxCornerRadiusBottomEnd="16dp"
                    app:boxStrokeWidth="1dp"
                    app:boxStrokeColor="#E0E0E0"
                    app:boxStrokeWidthFocused="2dp"
                    app:hintEnabled="false"
                    android:layout_marginBottom="16dp"
                    style="@style/Widget.Material3.TextInputLayout.FilledBox">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/autoCompleteFood"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:completionThreshold="1"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingTop="16dp"
                        android:paddingBottom="16dp"
                        android:minHeight="56dp"
                        android:background="@android:color/transparent" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Label for Quantity -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Số lượng"
                    android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                    android:textColor="@color/text_secondary"
                    android:layout_marginBottom="8dp" />

                <!-- Quantity input - Filled style -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:startIconDrawable="@android:drawable/ic_menu_sort_by_size"
                    app:startIconTint="@color/gradient_start_food"
                    app:suffixText="gram"
                    app:suffixTextColor="@color/gradient_start_food"
                    app:boxBackgroundMode="filled"
                    app:boxBackgroundColor="#FAFAFA"
                    app:boxCornerRadiusTopStart="16dp"
                    app:boxCornerRadiusTopEnd="16dp"
                    app:boxCornerRadiusBottomStart="16dp"
                    app:boxCornerRadiusBottomEnd="16dp"
                    app:boxStrokeWidth="1dp"
                    app:boxStrokeColor="#E0E0E0"
                    app:boxStrokeWidthFocused="2dp"
                    app:hintEnabled="false"
                    android:layout_marginBottom="8dp"
                    style="@style/Widget.Material3.TextInputLayout.FilledBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editTextQuantity"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingTop="16dp"
                        android:paddingBottom="16dp"
                        android:minHeight="56dp"
                        android:background="@android:color/transparent" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Calories Display (Realtime) -->
                <LinearLayout
                    android:id="@+id/layoutCaloriesInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:background="@drawable/bg_calories_info"
                    android:layout_marginBottom="16dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@android:drawable/ic_menu_info_details"
                        app:tint="@color/gradient_start_food"
                        android:layout_marginEnd="8dp"
                        android:contentDescription="Calories icon" />

                    <TextView
                        android:id="@+id/textCaloriesInfo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Tổng calories: 0 kcal"
                        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                        android:textStyle="bold"
                        android:textColor="@color/gradient_start_food" />
                </LinearLayout>

                <!-- Meal type selection - ChipGroup -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bữa ăn"
                    android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="12dp" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupMealType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:singleSelection="true"
                    app:checkedChip="@id/chipBreakfast"
                    app:chipSpacing="8dp"
                    android:layout_marginBottom="20dp">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipBreakfast"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sáng"
                        android:textSize="13sp"
                        android:checkable="true"
                        android:minHeight="40dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        style="@style/Widget.Material3.Chip.Filter"
                        app:chipBackgroundColor="@color/chip_background_food"
                        app:chipStrokeColor="@color/gradient_start_food"
                        app:chipStrokeWidth="1.5dp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipLunch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Trưa"
                        android:textSize="13sp"
                        android:checkable="true"
                        android:minHeight="40dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        style="@style/Widget.Material3.Chip.Filter"
                        app:chipBackgroundColor="@color/chip_background_food"
                        app:chipStrokeColor="@color/gradient_start_food"
                        app:chipStrokeWidth="1.5dp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipDinner"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tối"
                        android:textSize="13sp"
                        android:checkable="true"
                        android:minHeight="40dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        style="@style/Widget.Material3.Chip.Filter"
                        app:chipBackgroundColor="@color/chip_background_food"
                        app:chipStrokeColor="@color/gradient_start_food"
                        app:chipStrokeWidth="1.5dp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipSnack"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Xế"
                        android:textSize="13sp"
                        android:checkable="true"
                        android:minHeight="40dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        style="@style/Widget.Material3.Chip.Filter"
                        app:chipBackgroundColor="@color/chip_background_food"
                        app:chipStrokeColor="@color/gradient_start_food"
                        app:chipStrokeWidth="1.5dp" />

                </com.google.android.material.chip.ChipGroup>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Submit button - Modern Gradient style -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonLogFood"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Ghi lại bữa ăn"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:background="@drawable/bg_button_ripple_food"
            android:elevation="4dp"
            android:stateListAnimator="@null"
            app:icon="@android:drawable/ic_menu_save"
            app:iconGravity="textStart"
            app:iconTint="@color/white"
            app:iconSize="20dp"
            app:cornerRadius="16dp"
            android:layout_marginBottom="16dp"
            style="@style/Widget.Material3.Button" />

        <!-- Progress indicator -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:visibility="gone" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
